{
  "name": "taido",
  "private": true,
  "author": "Shyhn",
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fake": "node --test tools/fake-claude/test tools/fake-codex/test",
    "typecheck": "tsc --noEmit",
    "check:core": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "check:server": "cd crates/sync-proto && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test && cd ../../sync-server && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "check:mobile": "pnpm build:mobile && node mobile/check-dist.mjs",
    "test:e2e": "cargo build --manifest-path sync-server/Cargo.toml && TAIDO_SYNC_SERVER_BIN=sync-server/target/debug/taido-sync-server vitest run src/mobile/sync-e2e.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:fake && pnpm check:core && pnpm check:server && pnpm check:mobile && pnpm test:e2e",
    "dev:mobile": "vite --config vite.mobile.config.ts --mode mobile",
    "build:mobile": "tsc && vite build --config vite.mobile.config.ts --mode mobile"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.49.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
