{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taido",
  "version": "0.1.0",
  "identifier": "com.nuops.taido",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Taido",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-",
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 178
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 178
        }
      }
    },
    "publisher": "NUOPS",
    "copyright": "© 2026 NUOPS",
    "category": "Productivity",
    "shortDescription": "Tes tâches, et Claude Code qui travaille dedans.",
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "startMenuFolder": "Taido"
      }
    }
  }
}
