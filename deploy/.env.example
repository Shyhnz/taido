# Copy this file to ".env" and edit it. Never commit ".env" or put it in a repository:
# it can hold your mail password. After any change, run: docker compose up -d

# Your domain. It must have an A record pointing to this server.
TAIDO_DOMAIN=sync.example.com

# "open": anyone who knows the address can create an account from the desktop app.
# "closed": new accounts are refused (existing accounts keep working).
TAIDO_SIGNUPS=open

# Address put in e-mails (default: https://<TAIDO_DOMAIN>).
# TAIDO_PUBLIC_URL=https://sync.example.com

# Optional e-mail: password reset by code and address confirmation. Setting the host turns it on.
# TAIDO_SMTP_HOST=smtp.example.com
# Port: 465 (default) uses implicit TLS, any other port uses STARTTLS.
# TAIDO_SMTP_PORT=465
# SMTP login and password (give both, or neither).
# TAIDO_SMTP_USER=noreply@example.com
# TAIDO_SMTP_PASSWORD=change-me
# Sender shown in e-mails (required with TAIDO_SMTP_HOST).
# TAIDO_MAIL_FROM=Taido <noreply@example.com>

# Optional limits, in bytes.
# Largest single file (default 104857600 = 100 MB).
# TAIDO_MAX_FILE_BYTES=104857600
# Total file space per account (default 2147483648 = 2 GB).
# TAIDO_ACCOUNT_QUOTA_BYTES=2147483648
# Free disk space the server keeps; uploads that would eat into it are refused (default 2 GB).
# TAIDO_MIN_FREE_BYTES=2147483648
# Size of the synchronised tasks and notes per account (default 52428800 = 50 MB).
# TAIDO_RECORDS_QUOTA_BYTES=52428800
